  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "@types/react": "^18.3.12",
    "ink-testing-library": "^4.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.2"
  },
  "files": [
    "bin/run.js",
    "dist/**/*.js",
    "templates/**/*",
    "LICENSE"

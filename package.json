{
  "name": "lloyal-cli",
  "version": "0.11.0",
  "description": "The Harness Development Kit CLI — scaffold HDK harnesses and apps.",
  "bin": {
    "lloyal": "bin/run.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lloyal-ai/lloyal.git"
  },
  "homepage": "https://github.com/lloyal-ai/lloyal#readme",
  "bugs": {
    "url": "https://github.com/lloyal-ai/lloyal/issues"
  },
  "keywords": [
    "hdk",
    "harness",
    "cli",
    "scaffold",
    "agents",
    "llm"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {

    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "@lloyal-labs/channel-verify": "^0.1.0",
    "ink": "^5.0.1",
